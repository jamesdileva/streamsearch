# Copy to .env (never commit .env)
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=10
YOUTUBE_LOCATION_RADIUS=100km
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_MAX_RESULTS=10
TWITCH_MAX_CATEGORIES=3
TWITCH_EMBED_PARENT=localhost
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_MAX_RESULTS=25
KICK_MAX_CATEGORIES=3
KICK_EMBED_PARENT=localhost
FRESHNESS_FRESH_SECONDS=300
FRESHNESS_AGING_SECONDS=1800
CACHE_TTL_SECONDS=60
REFRESH_ENABLED=1
REFRESH_INTERVAL_SECONDS=900
REFRESH_BATCH_SIZE=10
REFRESH_PRUNE_DAYS=30
# Bearer token for POST /api/refresh. Empty = endpoint disabled (fail closed).
REFRESH_TOKEN=
OLLAMA_HOST=http://localhost:11434
EMBEDDINGS_MODEL=nomic-embed-text
# Leave blank to use each model's documented query/doc preset
EMBEDDINGS_QUERY_PREFIX=
EMBEDDINGS_DOC_PREFIX=
DATABASE_URL=sqlite:///./streamsearch.db
APP_ENV=development
