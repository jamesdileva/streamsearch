# Copy to .env (never commit .env)
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=10
YOUTUBE_LOCATION_RADIUS=100km
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
